// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed with bcrypt; null for OAuth-only users
  role          Role      @default(CUSTOMER)

  accounts Account[]
  sessions Session[]
  cart     Cart?
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Required by @auth/prisma-adapter — fixed shape, do not modify.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Required by @auth/prisma-adapter — fixed shape, do not modify.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required by @auth/prisma-adapter — fixed shape, do not modify.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Catalog ─────────────────────────────────────────────────────────────

model Genre {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EbookFileType {
  PDF
  EPUB
}

model Book {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  author      String
  isbn        String?  @unique
  description String   @db.Text
  coverImages String[]

  // At least one of these two must be set — enforced at the application
  // layer, not the DB, since Prisma has no cross-column CHECK constraint.
  ebookPrice    Decimal? @db.Decimal(10, 2)
  hardcopyPrice Decimal? @db.Decimal(10, 2)
  // Only meaningful for the hardcopy format — ebooks are an infinite digital good.
  hardcopyStock Int      @default(0)

  ebookFileUrl  String?
  ebookFileType EbookFileType?

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genreId])
}

// ─── Cart ────────────────────────────────────────────────────────────────

enum PurchaseFormat {
  EBOOK
  HARDCOPY
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id       String         @id @default(cuid())
  // Always 1 for EBOOK (digital access isn't bought in multiples);
  // enforced in the cart store / server actions, not the schema.
  quantity Int            @default(1)
  format   PurchaseFormat

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, bookId, format])
}

// ─── Orders ──────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(PENDING)
  total  Decimal     @db.Decimal(10, 2)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  items OrderItem[]

  // Null when the order contains only EBOOK items — nothing ships.
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?

  // Stripe reconciliation
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OrderItem {
  id       String         @id @default(cuid())
  quantity Int
  // Snapshot of price/title at time of purchase — book data may change later.
  price    Decimal        @db.Decimal(10, 2)
  title    String
  format   PurchaseFormat

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
